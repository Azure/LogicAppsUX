# CFS (Central Feed Service) registry config for SFI Network Isolation compliance (MountainPass SR21).
# Appended to the repo root .npmrc by .azure-pipelines/templates/setup.yml during ADO pipeline builds ONLY.
# Local dev and GitHub Actions keep the default public npm registry — do not add these settings to the root .npmrc.
# Original config generated by Gardener Plugin CentralFeedServiceAdoptionPlugin.
registry=https://pkgs.dev.azure.com/msazure/one/_packaging/one_PublicPackages/npm/registry/
always-auth=true
# Disable postinstall scripts for supply chain security hardening
ignore-scripts=true
