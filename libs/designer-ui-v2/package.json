{
  "name": "@microsoft/designer-ui-v2",
  "version": "5.110.0",
  "private": true,
  "description": "Private local PoC for host-neutral Fluent v9 designer presentation",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "typesVersions": {
    "*": { "metrics": ["src/metrics.ts", "build/lib/metrics.d.ts"] }
  },
  "files": ["build/lib/**/*"],
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" },
    "./metrics": { "types": "./src/metrics.ts", "import": "./src/metrics.ts", "default": "./src/metrics.ts" },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "build/lib/index.js",
    "module": "build/lib/index.js",
    "types": "build/lib/index.d.ts",
    "exports": {
      ".": { "types": "./build/lib/index.d.ts", "import": "./build/lib/index.js", "default": "./build/lib/index.js" },
      "./metrics": {
        "types": "./build/lib/metrics.d.ts",
        "import": "./build/lib/metrics.js",
        "default": "./build/lib/metrics.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@fluentui/react-icons": "^2.0.315" },
  "peerDependencies": {
    "@fluentui/react-components": "^9.74.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build:lib": "tsup && tsc --emitDeclarationOnly",
    "test:lib": "pnpm run build:lib && vitest run",
    "storybook": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsc --project tsconfig.storybook.json",
    "test:storybook-inventory": "node --test .storybook/check-inventory.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "storybook": "8.6.14",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
