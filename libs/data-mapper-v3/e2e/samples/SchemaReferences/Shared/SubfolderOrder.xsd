<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:c="urn:samples:common"
           xmlns:cur="urn:samples:currency"
           targetNamespace="urn:samples:subfolder-order"
           xmlns="urn:samples:subfolder-order"
           elementFormDefault="qualified">
  <xs:import namespace="urn:samples:common" schemaLocation="..\Common.xsd"/>
  <xs:import namespace="urn:samples:currency" schemaLocation=".\Currency.xsd"/>
  <xs:element name="Order">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="OrderId" type="xs:string"/>
        <xs:element name="CustomerName" type="xs:string"/>
        <xs:element name="ShipTo" type="c:AddressType"/>
        <xs:element name="Total" type="xs:decimal"/>
        <xs:element name="Currency" type="cur:CurrencyCode" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
