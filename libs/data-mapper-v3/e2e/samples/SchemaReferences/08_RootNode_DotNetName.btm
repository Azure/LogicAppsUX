<?xml version="1.0" encoding="utf-8"?>
<!-- Same as 07 but referenced by .NET name; v3 should use RootNode_Name when picking the schema/root. -->
<mapsource Name="08 RootNode_Name with .NET name" Version="2" OmitXmlDeclaration="Yes"
           PreserveSequenceOrder="Yes" TreatElementsAsRecords="Yes">
  <SrcTree RootNode_Name="Order">
    <Reference Location="Samples.Schemas.MultiRoot"/>
  </SrcTree>
  <TrgTree RootNode_Name="Invoice">
    <Reference Location="Samples.Schemas.MultiRoot"/>
  </TrgTree>
  <Pages>
    <Page Name="Page 1">
      <Links>
        <Link LinkID="link1" SourceID="/Order/OrderId" SourcePath="/Order/OrderId" TargetID="/Invoice/InvoiceId" TargetPath="/Invoice/InvoiceId" SourceType="schemaNode" TargetType="schemaNode"/>
        <Link LinkID="link2" SourceID="/Order/CustomerName" SourcePath="/Order/CustomerName" TargetID="/Invoice/Customer" TargetPath="/Invoice/Customer" SourceType="schemaNode" TargetType="schemaNode"/>
        <Link LinkID="link3" SourceID="/Order/ShipTo/Street" SourcePath="/Order/ShipTo/Street" TargetID="/Invoice/BillTo/Street" TargetPath="/Invoice/BillTo/Street" SourceType="schemaNode" TargetType="schemaNode"/>
        <Link LinkID="link4" SourceID="/Order/ShipTo/City" SourcePath="/Order/ShipTo/City" TargetID="/Invoice/BillTo/City" TargetPath="/Invoice/BillTo/City" SourceType="schemaNode" TargetType="schemaNode"/>
        <Link LinkID="link5" SourceID="/Order/Total" SourcePath="/Order/Total" TargetID="/Invoice/Amount" TargetPath="/Invoice/Amount" SourceType="schemaNode" TargetType="schemaNode"/>
      </Links>
      <Functoids/>
    </Page>
  </Pages>
</mapsource>
