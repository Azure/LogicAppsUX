{
  "name": "btm-data-mapper",
  "displayName": "Logic App Data Mapper",
  "description": "Logic App Data Mapper for VS Code - visual BizTalk-compatible schema mapping with functoids and XSLT generation",
  "version": "0.0.20",
  "publisher": "microsoft",
  "icon": "media/icons/biztalk-icon.jpg",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9",
    "vscode": "^1.103.0"
  },
  "private": true,
  "categories": ["Other", "Visualization"],
  "keywords": ["biztalk", "mapper", "xslt", "xml", "schema", "data mapping", "functoids"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "biztalkDataMapper",
          "title": "Logic App Data Mapper",
          "icon": "media/icons/mapper.svg"
        }
      ]
    },
    "views": {
      "biztalkDataMapper": [
        {
          "id": "biztalkDataMapper.mapsView",
          "name": "Maps"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "biztalkDataMapper.mapsView",
        "contents": "No maps found in this workspace.\n[Add Mapper Project](command:biztalkDataMapper.newMap)\n[Open Existing Mapper](command:biztalkDataMapper.openMap)\nTo get started, add a mapper project or open an existing one."
      }
    ],
    "customEditors": [
      {
        "viewType": "biztalkDataMapper.mapEditor",
        "displayName": "Logic App Data Mapper",
        "selector": [
          {
            "filenamePattern": "*.btm"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "biztalkDataMapper.showLogs",
        "title": "Logic App: Show Data Mapper Logs"
      },
      {
        "command": "biztalkDataMapper.newMap",
        "title": "Add Mapper Project",
        "category": "Logic App",
        "icon": "$(add)"
      },
      {
        "command": "biztalkDataMapper.openMap",
        "title": "Open Existing Mapper",
        "category": "Logic App",
        "icon": "$(folder-opened)"
      },
      {
        "command": "biztalkDataMapper.addDataMap",
        "title": "Add Data Map",
        "icon": "$(new-file)"
      },
      {
        "command": "biztalkDataMapper.importExistingMap",
        "title": "Import Existing Map",
        "icon": "$(go-to-file)"
      },
      {
        "command": "biztalkDataMapper.addSchemaFile",
        "title": "Add Schema File",
        "icon": "$(file-add)"
      },
      {
        "command": "biztalkDataMapper.openDataMap",
        "title": "Open Data Mapper"
      },
      {
        "command": "biztalkDataMapper.editDataMap",
        "title": "Edit Data Map as Text"
      },
      {
        "command": "biztalkDataMapper.compileMap",
        "title": "Logic App: Compile Map to XSLT"
      },
      {
        "command": "biztalkDataMapper.testMap",
        "title": "Logic App: Test Map"
      },
      {
        "command": "biztalkDataMapper.validateMap",
        "title": "Logic App: Validate Map"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "biztalkDataMapper.newMap",
          "when": "view == biztalkDataMapper.mapsView",
          "group": "navigation"
        },
        {
          "command": "biztalkDataMapper.openMap",
          "when": "view == biztalkDataMapper.mapsView",
          "group": "navigation"
        },
        {
          "submenu": "biztalkDataMapper.addMapMenu",
          "when": "view == biztalkDataMapper.mapsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "biztalkDataMapper.openDataMap",
          "when": "view == biztalkDataMapper.mapsView && viewItem == btmFile",
          "group": "inline"
        },
        {
          "command": "biztalkDataMapper.editDataMap",
          "when": "view == biztalkDataMapper.mapsView && viewItem == btmFile",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "biztalkDataMapper.addDataMap",
          "when": "explorerResourceIsFolder && resourceFilename != Schemas && resourceFilename != __generated",
          "group": "navigation@10"
        },
        {
          "command": "biztalkDataMapper.importExistingMap",
          "when": "explorerResourceIsFolder && resourceFilename != Schemas && resourceFilename != __generated",
          "group": "navigation@11"
        },
        {
          "command": "biztalkDataMapper.addSchemaFile",
          "when": "explorerResourceIsFolder && resourceFilename == Schemas",
          "group": "navigation@10"
        },
        {
          "command": "biztalkDataMapper.openDataMap",
          "when": "resourceExtname == .btm",
          "group": "navigation@10"
        },
        {
          "command": "biztalkDataMapper.editDataMap",
          "when": "resourceExtname == .btm",
          "group": "navigation@11"
        }
      ],
      "biztalkDataMapper.addMapMenu": [
        {
          "command": "biztalkDataMapper.addDataMap",
          "group": "1_add@1"
        },
        {
          "command": "biztalkDataMapper.importExistingMap",
          "group": "1_add@2"
        }
      ]
    },
    "configuration": {
      "title": "Logic App Data Mapper",
      "properties": {
        "biztalkDataMapper.defaultXsltVersion": {
          "type": "string",
          "default": "1.0",
          "enum": ["1.0", "2.0"],
          "description": "Default XSLT version for compiled maps"
        },
        "biztalkDataMapper.omitXmlDeclaration": {
          "type": "boolean",
          "default": false,
          "description": "Omit XML declaration in XSLT output"
        },
        "biztalkDataMapper.preserveSequenceOrder": {
          "type": "boolean",
          "default": true,
          "description": "Preserve sequence order in generated XSLT"
        }
      }
    },
    "submenus": [
      {
        "id": "biztalkDataMapper.addMapMenu",
        "label": "Add Data Map",
        "icon": "$(new-file)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run publish:framework-transform && pnpm run publish:worker && pnpm run bundle",
    "publish:framework-transform": "dotnet build \".\\tools\\compiler-worker\\BizTalk.DataMapper.FrameworkTransform\\BizTalk.DataMapper.FrameworkTransform.csproj\" --configuration Release --output \".\\tools\\compiler-worker\\runtime\\win-x64\\framework-transform\"",
    "publish:worker": "dotnet publish \".\\tools\\compiler-worker\\BizTalk.DataMapper.Worker\\BizTalk.DataMapper.Worker.csproj\" --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=false --output \".\\tools\\compiler-worker\\runtime\\win-x64\"",
    "publish:worker:debug": "dotnet publish \".\\tools\\compiler-worker\\BizTalk.DataMapper.Worker\\BizTalk.DataMapper.Worker.csproj\" --configuration Debug --runtime win-x64 --self-contained true -p:PublishSingleFile=false --output \".\\tools\\compiler-worker\\runtime\\win-x64\"",
    "bundle": "webpack --mode production --config webpack.extension.config.js && webpack --mode production --config webpack.webview.config.js",
    "bundle:dev": "webpack --mode development --config webpack.extension.config.js && webpack --mode development --config webpack.webview.config.js",
    "build:extension": "pnpm run bundle",
    "debug:prepare": "pnpm run publish:framework-transform && pnpm run publish:worker:debug && pnpm run bundle:dev",
    "compile": "tsc --noEmit -p tsconfig.json && pnpm run compile:webview",
    "compile:webview": "tsc --noEmit -p webview/tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "watch:webview": "webpack --watch --mode development --config webpack.webview.config.js",
    "lint": "eslint src",
    "generate:profile-map": "node scripts/generate-profile-map.js",
    "test": "jest",
    "test:extension-unit": "pnpm run test",
    "test:webview": "pnpm run compile:webview && webpack --mode development --config webpack.webview.config.js && node test/webview-smoke/run.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@types/vscode": "1.103.0",
    "@vscode/vsce": "3.1.1",
    "css-loader": "^6.8.1",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "^2.0.306",
    "fast-xml-parser": "^4.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1",
    "xmlbuilder2": "^3.1.1",
    "xslt-processor": "^5.0.11"
  }
}
