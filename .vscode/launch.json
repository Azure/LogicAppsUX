{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Designer Extension in Dev Mode",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vs-code-designer/dist"],
      "trace": false,
      "internalConsoleOptions": "openOnFirstSessionStart",
      "outFiles": ["${workspaceFolder}/apps/vs-code-designer/dist/*.js"],
      "preLaunchTask": "npm: build:extension",
      "env": {
        "DEBUGTELEMETRY": "v",
        "LSP_SERVER_DEV_PATH": "/Users/carloscastro/Documents/Dev/Agent_C_Sharp_Server/Server/bin/Debug/net8.0/SdkLspServer.dll"
      }
    },
    {
      "name": "E2E: Select mode (run-e2e)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/vs-code-designer",
      "program": "${workspaceFolder}/apps/vs-code-designer/out/test/run-e2e.js",
      "preLaunchTask": "E2E: build extension and compile VS Code UI tests",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "E2E_MODE": "${input:e2eMode}"
      }
    },
    {
      "name": "E2E: p49 NuGet debug conversion",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/vs-code-designer",
      "program": "${workspaceFolder}/apps/vs-code-designer/out/test/run-e2e.js",
      "preLaunchTask": "E2E: build extension and compile VS Code UI tests",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "E2E_MODE": "nugetdebugonly"
      }
    },
    {
      "name": "E2E: full suite",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/vs-code-designer",
      "program": "${workspaceFolder}/apps/vs-code-designer/out/test/run-e2e.js",
      "preLaunchTask": "E2E: build extension and compile VS Code UI tests",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "E2E_MODE": "full"
      }
    },
    {
      "name": "E2E: create workspaces only",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/vs-code-designer",
