  "inputs": [
    {
      "id": "e2eMode",
      "type": "pickString",
      "description": "E2E_MODE for apps/vs-code-designer/src/test/ui/run-e2e.ts",
      "default": "nugetdebugonly",
      "options": [
        "nugetdebugonly",
        "full",
        "createonly",
        "designeronly",
        "newtestsonly",
        "conversiononly",
        "conversioncreateonly",
        "nonlogicappstartup",
        "codefuldebugonly",
        "bundlerepaironly",
        "bundleintegrityonly",
        "lspeperm",
        "scenarios",
        "scenarios-pilot",
        "independentonly",
        "createplusdesigner",
        "createplusnewtests",
        "createplusconversion"
      ]
    }
